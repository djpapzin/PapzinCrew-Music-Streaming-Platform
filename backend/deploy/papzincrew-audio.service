[Unit]
Description=Papzin & Crew public cached audio HTTPS
After=network-online.target papzincrew-backend.service
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=papzincrew-audio
Environment=XDG_DATA_HOME=/var/lib/papzincrew-audio
Environment=XDG_CONFIG_HOME=/var/lib/papzincrew-audio
ExecStart=/usr/local/bin/papzincrew-caddy run --config /etc/papzincrew/audio-cache.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=128M
CPUQuota=50%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
