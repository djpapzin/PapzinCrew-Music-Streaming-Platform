{
    admin off
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

audio.djpapzin.com {
    bind 10.0.0.211
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            disable_http_challenge
        }
    }
    @cached {
        path_regexp cached "^/tracks/[0-9]+/cached/[a-f0-9]{24}$"
        method GET HEAD
    }
    # INACTIVE proposal. Apply only after explicit deployment + single-write approval.
    @pilot {
        path /intake/pilot /intake/pilot/page.js /intake/pilot/upload
    }
    @intake {
        path /intake/upload
    }
    route {
        handle @pilot {
            request_body {
                max_size 28311552
            }
            reverse_proxy 127.0.0.1:18883 {
                transport http {
                    read_timeout 15m
                    write_timeout 15m
                    response_header_timeout 15m
                }
            }
        }
        handle @intake {
            respond "Uploads are temporarily paused. Listening and downloads are still available." 503
        }
        reverse_proxy @cached 127.0.0.1:18882
        respond 404
    }
}
